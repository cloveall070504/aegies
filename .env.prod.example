# ============================================================
# 生产 .env 模板（复制为 .env 后填写，配合 docker-compose.prod.yml）
# 本文件只含占位符，可提交仓库；真正的 .env 含密钥，已被 gitignore。
# 用法：docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# ============================================================

# ---- 域名（Caddy 据此向 Let's Encrypt 自动申请/续期 HTTPS 证书）----
DOMAIN=yourdomain.com

# ---- 数据库（PostgreSQL，compose 内自动拼连接串）----
DB_PASSWORD=请改成强密码

# ---- JWT 签名密钥（务必随机！可用 `openssl rand -hex 32` 生成）----
SECRET_KEY=请改成随机串

# ---- 云端大模型（千问云端 / 任意 OpenAI 兼容端点）----
AI_PROVIDER=cloud
OPENAI_API_KEY=sk-你的DashScopeKey
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# ---- 本地 Ollama（云服务器一般没有，关掉；留空默认 false）----
ENABLE_OLLAMA=false
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# 说明：
# - CORS_ORIGINS 由 compose 自动设为 https://${DOMAIN}，无需在此填写
# - HOST/PORT 由 compose 固定为 0.0.0.0/8000，无需填写
# - DATABASE_URL 由 compose 用 DB_PASSWORD 自动拼，无需填写
