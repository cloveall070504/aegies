# ===== AI实操避错系统 · 后端环境变量示例 =====
# 复制为 .env 后按需修改。所有项均可选，未设置时取 config.py 中的默认值。

# --- 服务绑定 ---
HOST=127.0.0.1
PORT=8001

# --- 数据库 ---
# 开发默认 SQLite；生产改为 PostgreSQL，例如：
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///./ai_avoid_error.db

# --- 安全 ---
# ⚠️ 生产必须通过环境变量设置随机密钥！
SECRET_KEY=change-me-to-a-random-string
# 令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI（Ollama）---
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- 日志 ---
LOG_LEVEL=INFO
# LOG_DIR 默认 <backend>/logs
# LOG_MAX_BYTES 默认 10485760（10MB）
# LOG_BACKUPS 默认 5

# --- 备份 ---
# BACKUP_DIR 默认 <backend>/data/backups

# --- CORS（生产必须显式设置，留空则放行一组 localhost 开发源）---
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
