# ===== AI实操避错系统 · 后端环境变量示例 =====
# 复制为 .env 后按需修改。所有项均可选，未设置时取 config.py 中的默认值。

# --- 服务绑定 ---
HOST=127.0.0.1
PORT=8001

# --- 数据库 ---
# 开发默认 SQLite；生产改为 PostgreSQL，例如：
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///./ai_avoid_error.db

# --- 安全 ---
# ⚠️ 生产必须通过环境变量设置随机密钥！
# 开发默认使用 config.py 中的值；如果在此处设置，必须与当前运行实例的密钥一致，
# 否则会导致已签发的 JWT token 失效，前端被 401 并显示「规则模式」。
# SECRET_KEY=chy07-dev-only-key-DO-NOT-USE-IN-PRODUCTION
# 令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI（Ollama）---
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- AI（云端大模型，OpenAI 兼容）---
# AI_PROVIDER=ollama 时使用上面的本地 Ollama；改为 cloud 则走云端 API（无需本机安装 Ollama）。
# 支持任意 OpenAI 兼容端点：DeepSeek / 硅基流动 SiliconFlow / 通义 DashScope / OpenAI 等。
# 注意：下面的 base/model 是默认（DeepSeek），可按厂商修改；密钥务必填真实值且不要提交。
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# --- 日志 ---
LOG_LEVEL=INFO
# LOG_DIR 默认 <backend>/logs
# LOG_MAX_BYTES 默认 10485760（10MB）
# LOG_BACKUPS 默认 5

# --- 备份 ---
# BACKUP_DIR 默认 <backend>/data/backups

# --- CORS（生产必须显式设置，留空则放行一组 localhost 开发源）---
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
