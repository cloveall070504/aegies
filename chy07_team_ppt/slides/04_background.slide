<Slide style={{ width: '1280px', height: '720px', background: '#0F172A', padding: '20px 64px', display: 'flex', flexDirection: 'column', fontFamily: 'Microsoft YaHei, sans-serif' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
    <Box style={{ width: 6, height: 38, background: 'linear-gradient(180deg, #3B82F6, #06B6D4)', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E2E8F0' }}>项目背景与技术栈</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 48, paddingTop: 12 }}>
    <Box style={{ width: '32%', justifyContent: 'center' }}>
      <Text style={{ fontSize: 20, color: '#64748B', letterSpacing: 2 }}>PROJECT</Text>
      <Text style={{ fontSize: 20, color: '#64748B', letterSpacing: 2 }}>BACKGROUND</Text>
      <Box style={{ width: 64, height: 4, background: '#8B5CF6', margin: '18px 0' }} />
      <Text style={{ fontSize: 18, color: '#94A3B8', lineHeight: 1.6 }}>实战避错系统<br/>规则引擎为唯一事实源</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 22 }}>
      <Text style={{ fontSize: 21, color: '#E2E8F0', lineHeight: 1.6 }}>chy07 是一套 <span style={{ color: '#3B82F6', fontWeight: 'bold' }}>FastAPI + React</span> 的 实战避错系统（聚焦化学实验安全实训）：以规则引擎作为唯一事实源，AI Agent 在其约束下推理，杜绝幻觉。</Text>
      <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12 }}>
        <Box style={{ padding: '8px 16px', background: 'rgba(59,130,246,0.12)', borderRadius: 8, border: '1px solid rgba(59,130,246,0.4)' }}><Text style={{ fontSize: 16, color: '#93C5FD' }}>FastAPI</Text></Box>
        <Box style={{ padding: '8px 16px', background: 'rgba(59,130,246,0.12)', borderRadius: 8, border: '1px solid rgba(59,130,246,0.4)' }}><Text style={{ fontSize: 16, color: '#93C5FD' }}>React</Text></Box>
        <Box style={{ padding: '8px 16px', background: 'rgba(6,182,212,0.12)', borderRadius: 8, border: '1px solid rgba(6,182,212,0.4)' }}><Text style={{ fontSize: 16, color: '#67E8F9' }}>PostgreSQL</Text></Box>
        <Box style={{ padding: '8px 16px', background: 'rgba(6,182,212,0.12)', borderRadius: 8, border: '1px solid rgba(6,182,212,0.4)' }}><Text style={{ fontSize: 16, color: '#67E8F9' }}>ChromaDB</Text></Box>
        <Box style={{ padding: '8px 16px', background: 'rgba(139,92,246,0.12)', borderRadius: 8, border: '1px solid rgba(139,92,246,0.4)' }}><Text style={{ fontSize: 16, color: '#C4B5FD' }}>规则引擎</Text></Box>
        <Box style={{ padding: '8px 16px', background: 'rgba(139,92,246,0.12)', borderRadius: 8, border: '1px solid rgba(139,92,246,0.4)' }}><Text style={{ fontSize: 16, color: '#C4B5FD' }}>DashScope</Text></Box>
      </Box>
      <Text style={{ fontSize: 18, color: '#94A3B8', lineHeight: 1.6 }}>LLM 正从本地 <span style={{ color: '#06B6D4' }}>Ollama qwen2.5:3b</span> 迁移至云端 <span style={{ color: '#06B6D4' }}>通义千问 qwen-plus</span>，需验证 .env 切换与接口行为回归。</Text>
    </Box>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
