    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E2E8F0' }}>模块依赖主干</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 36, alignItems: 'center' }}>
    <Box style={{ width: '54%', justifyContent: 'center' }}>
      <svg width={560} height={500} viewBox='0 0 560 500'>
        <defs>
          <marker id='arrow' markerWidth='10' markerHeight='10' refX='8' refY='3' orient='auto'>
