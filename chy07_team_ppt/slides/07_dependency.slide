        <text x='280' y='68' textAnchor='middle' fill='#93C5FD' fontSize='14'>唯一事实源</text>
        <rect x='40' y='180' width='180' height='56' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
        <text x='130' y='204' textAnchor='middle' fill='#E2E8F0' fontSize='18' fontWeight='bold'>王天豪 · 仿真</text>
        <text x='130' y='224' textAnchor='middle' fill='#94A3B8' fontSize='13'>评分</text>
        <rect x='340' y='180' width='180' height='56' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
