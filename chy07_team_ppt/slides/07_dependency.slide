        <text x='430' y='224' textAnchor='middle' fill='#94A3B8' fontSize='13'>题库场景</text>
        <rect x='200' y='330' width='200' height='60' rx='10' fill='#1E293B' stroke='#8B5CF6' strokeWidth='2' />
        <text x='300' y='356' textAnchor='middle' fill='#E2E8F0' fontSize='18' fontWeight='bold'>陈浩研 · 总和集成</text>
        <text x='300' y='378' textAnchor='middle' fill='#C4B5FD' fontSize='13'>仪表盘汇总</text>
        <rect x='20' y='430' width='180' height='56' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
