        <text x='460' y='62' textAnchor='middle' fill='#C4B5FD' fontSize='12'>连锁反应</text>
        <rect x='120' y='180' width='300' height='54' rx='10' fill='#1E293B' stroke='#8B5CF6' strokeWidth='2' />
        <text x='270' y='204' textAnchor='middle' fill='#E2E8F0' fontSize='15' fontWeight='bold'>关联真实事故案例</text>
        <text x='270' y='224' textAnchor='middle' fill='#C4B5FD' fontSize='12'>_related_case_ids · 给警示</text>
        <line x1='170' y1='47' x2='200' y2='47' stroke='#64748B' strokeWidth='2' markerEnd='url(#ar13)' />
