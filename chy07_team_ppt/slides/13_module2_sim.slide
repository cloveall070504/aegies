        <text x='95' y='62' textAnchor='middle' fill='#67E8F9' fontSize='12'>step / scene</text>
        <rect x='200' y='20' width='170' height='54' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
        <text x='285' y='44' textAnchor='middle' fill='#E2E8F0' fontSize='15' fontWeight='bold'>_simulate_world</text>
        <text x='285' y='62' textAnchor='middle' fill='#67E8F9' fontSize='12'>规则后果推演</text>
        <rect x='400' y='20' width='120' height='54' rx='10' fill='#1E293B' stroke='#8B5CF6' strokeWidth='2' />
