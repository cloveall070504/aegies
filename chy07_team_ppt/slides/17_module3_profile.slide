<Slide style={{ width: '1280px', height: '720px', background: '#0F172A', padding: '20px 64px', display: 'flex', flexDirection: 'column', fontFamily: 'Microsoft YaHei, sans-serif' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
    <Box style={{ width: 6, height: 38, background: 'linear-gradient(180deg, #3B82F6, #06B6D4)', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#E2E8F0' }}>模块三 · 用户与组织档案（朱帅铭）</Text>
    <Text style={{ fontSize: 16, color: '#06B6D4', marginLeft: 12, fontWeight: 'bold' }}>权限与数据双层隔离</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 32, alignItems: 'stretch' }}>
    <Box style={{ width: '57%', flexDirection: 'column', justifyContent: 'center', gap: 14 }}>
      <Box style={{ padding: '12px 16px', background: 'rgba(6,182,212,0.10)', borderRadius: 10, borderLeft: '4px solid #06B6D4' }}>
        <Text style={{ fontSize: 19, color: '#E2E8F0', lineHeight: 1.5 }}>定位：支撑<span style={{ color: '#06B6D4', fontWeight: 'bold' }}>多角色、多层级的档案体系</span>。</Text>
      </Box>
      <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12 }}>
        <Box style={{ width: '47%', padding: '13px 15px', background: 'rgba(6,182,212,0.10)', borderRadius: 10, border: '1px solid rgba(6,182,212,0.35)' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#67E8F9' }}>user 账户</Text>
          <Text style={{ fontSize: 14, color: '#CBD5E1', marginTop: 5 }}>登录主体 · 角色标记</Text>
        </Box>
        <Box style={{ width: '47%', padding: '13px 15px', background: 'rgba(6,182,212,0.10)', borderRadius: 10, border: '1px solid rgba(6,182,212,0.35)' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#67E8F9' }}>personal_profile</Text>
          <Text style={{ fontSize: 14, color: '#CBD5E1', marginTop: 5 }}>个人成长档案</Text>
        </Box>
        <Box style={{ width: '47%', padding: '13px 15px', background: 'rgba(139,92,246,0.12)', borderRadius: 10, border: '1px solid rgba(139,92,246,0.4)' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#C4B5FD' }}>org_profile</Text>
          <Text style={{ fontSize: 14, color: '#CBD5E1', marginTop: 5 }}>组织/班级/院系</Text>
        </Box>
        <Box style={{ width: '47%', padding: '13px 15px', background: 'rgba(139,92,246,0.12)', borderRadius: 10, border: '1px solid rgba(139,92,246,0.4)' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#C4B5FD' }}>profile_service</Text>
          <Text style={{ fontSize: 14, color: '#CBD5E1', marginTop: 5 }}>档案获取 / 刷新</Text>
        </Box>
      </Box>
      <Text style={{ fontSize: 16.5, color: '#CBD5E1', lineHeight: 1.55 }}>• 组织档案支持班级 / 院系层级管理，教师看班级、学生看个人。</Text>
    </Box>
    <Box style={{ width: '43%', padding: '20px 22px', background: 'rgba(30,41,59,0.7)', borderRadius: 12, border: '1px solid rgba(6,182,212,0.35)', flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
      <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#67E8F9' }}>隔离模型</Text>
      <Text style={{ fontSize: 15, color: '#E2E8F0' }}>• 权限隔离：角色决定能看什么</Text>
      <Text style={{ fontSize: 15, color: '#E2E8F0' }}>• 数据隔离：组织决定能看到谁</Text>
      <Box style={{ marginTop: 6, padding: '10px 13px', background: 'rgba(139,92,246,0.10)', borderRadius: 8, border: '1px dashed rgba(139,92,246,0.4)' }}>
        <Text style={{ fontSize: 14, color: '#C4B5FD' }}>教师 → 本班档案<br/>学生 → 仅本人档案</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 56, flexDirection: 'row', alignItems: 'center', gap: 14, padding: '0 18px', background: 'linear-gradient(90deg, rgba(6,182,212,0.16), rgba(139,92,246,0.05))', borderRadius: 10, border: '1px solid rgba(6,182,212,0.35)' }}>
    <Text style={{ fontSize: 15, color: '#06B6D4', fontWeight: 'bold' }}>答辩亮点</Text>
    <Text style={{ fontSize: 17.5, color: '#E2E8F0' }}>权限与数据双层隔离：教师看班级、学生看个人，既安全又满足实训管理诉求。</Text>
  </Box>
  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>实战避错系统 · 团队分工</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>17 / 25</Text>
  </Box>
</Slide>
