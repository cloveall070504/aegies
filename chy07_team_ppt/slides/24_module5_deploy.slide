        <text x='105' y='72' textAnchor='middle' fill='#67E8F9' fontSize='12'>编排</text>
        <rect x='200' y='30' width='150' height='54' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
        <text x='275' y='54' textAnchor='middle' fill='#E2E8F0' fontSize='14' fontWeight='bold'>Caddy</text>
        <text x='275' y='72' textAnchor='middle' fill='#67E8F9' fontSize='12'>代理/HTTPS</text>
        <rect x='370' y='30' width='140' height='54' rx='10' fill='#1E293B' stroke='#06B6D4' strokeWidth='2' />
